<diagram id="ov7670-infographic" name="Infographic">
<mxGraphModel adaptiveColors="auto" dx="1400" dy="1500" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1470" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="OV7670 camera on STM32H755: DCMI + DMA capture, frames to PC over UART" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="40" as="geometry"/></mxCell>
<mxCell id="sub" value="NUCLEO-H755ZI-Q (firmware on Cortex-M7, CubeMX + HAL) · OV7670 module without FIFO · jumper-wired to Zio headers · result: complete 320×240 RGB565 frames, recognisable image" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#5A626E;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1320" height="30" as="geometry"/></mxCell>
<mxCell id="s1" value="1 · Signal chain (final working configuration)" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;align=left;spacingLeft=12;fillColor=#F7F8FA;strokeColor=#D5DAE1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="1320" height="305" as="geometry"/></mxCell>
<mxCell id="mcu" value="STM32H755ZI · Cortex-M7" style="rounded=1;arcSize=4;dashed=1;html=1;fillColor=#FFFFFF;strokeColor=#9DB8F2;verticalAlign=bottom;align=right;spacingRight=10;spacingBottom=4;fontSize=13;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="s1"><mxGeometry x="295" y="40" width="680" height="250" as="geometry"/></mxCell>
<mxCell id="cam" value="&lt;b&gt;OV7670&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;VGA RGB565&lt;br&gt;own scaler off&lt;br&gt;no FIFO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="20" y="50" width="140" height="110" as="geometry"/></mxCell>
<mxCell id="dcmi" value="&lt;b&gt;DCMI&lt;/b&gt; (8-bit)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;keeps 2 of 4 bytes&lt;br&gt;+ every other line&lt;br&gt;640×480 → 320×240&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="310" y="50" width="140" height="110" as="geometry"/></mxCell>
<mxCell id="dma" value="&lt;b&gt;DMA1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;priority very high&lt;br&gt;(H7 DMA1/2 can't&lt;br&gt;reach DTCM)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="480" y="50" width="140" height="110" as="geometry"/></mxCell>
<mxCell id="ram" value="&lt;b&gt;AXI SRAM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;frame buffer&lt;br&gt;153,600 bytes&lt;br&gt;D-cache off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="650" y="50" width="140" height="110" as="geometry"/></mxCell>
<mxCell id="uart" value="&lt;b&gt;USART3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;115200 baud&lt;br&gt;≈13 s per frame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="820" y="50" width="140" height="110" as="geometry"/></mxCell>
<mxCell id="vcp" value="&lt;b&gt;ST-LINK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;virtual COM port&lt;br&gt;over USB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="990" y="50" width="140" height="110" as="geometry"/></mxCell>
<mxCell id="pc" value="&lt;b&gt;PC viewer&lt;/b&gt; (Python)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;requests a frame&lt;br&gt;decodes RGB565&lt;br&gt;line by line, displays&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="1160" y="50" width="140" height="110" as="geometry"/></mxCell>
<mxCell id="i2c" value="&lt;b&gt;I2C2 = SCCB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;PB10/PB11 · 100 kHz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="310" y="190" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="mco" value="&lt;b&gt;MCO1 · PA8&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;HSI/4 = 16 MHz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s1"><mxGeometry x="480" y="190" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="e1" value="&lt;b&gt;PCLK via 70 Ω&lt;/b&gt;&lt;br&gt;HREF · VSYNC · D0–D7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#C9302C;strokeWidth=2;fontSize=12;labelBackgroundColor=#F7F8FA;verticalAlign=bottom;" edge="1" parent="s1" source="cam" target="dcmi"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;" edge="1" parent="s1" source="dcmi" target="dma"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;" edge="1" parent="s1" source="dma" target="ram"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;" edge="1" parent="s1" source="ram" target="uart"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;" edge="1" parent="s1" source="uart" target="vcp"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;startArrow=classic;" edge="1" parent="s1" source="vcp" target="pc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="SCCB config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;dashed=1;entryX=0.7;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#F7F8FA;" edge="1" parent="s1" source="i2c" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="XCLK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#F7F8FA;" edge="1" parent="s1" source="mco" target="cam"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="555" y="275"/><mxPoint x="62" y="275"/></Array></mxGeometry></mxCell>
<mxCell id="s2" value="2 · Pin map (Zio headers)" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;align=left;spacingLeft=12;fillColor=#F7F8FA;strokeColor=#D5DAE1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="640" height="265" as="geometry"/></mxCell>
<mxCell id="pins" value="&lt;table cellpadding=&quot;3&quot; width=&quot;100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;XCLK (MCO1)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PA8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;SCCB SCL / SDA (I2C2)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PB10 / PB11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PCLK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PA6 (70 Ω at the camera end)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;HREF / VSYNC&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PA4 / PB7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;D0 – D3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PC6, PC7, PC8, PC9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;D4 – D7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PC11, PB6, PB8, PB9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;UART to PC&lt;/b&gt;&lt;/td&gt;&lt;td&gt;USART3 → ST-LINK VCP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#D5DAE1;rounded=1;arcSize=3;spacing=8;" vertex="1" parent="s2"><mxGeometry x="20" y="42" width="600" height="208" as="geometry"/></mxCell>
<mxCell id="s3" value="3 · Key numbers from the bench" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;align=left;spacingLeft=12;fillColor=#F7F8FA;strokeColor=#D5DAE1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="720" y="425" width="640" height="265" as="geometry"/></mxCell>
<mxCell id="k1" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;153,600 B&lt;/b&gt;&lt;/font&gt;&lt;br&gt;per frame (320×240×2),&lt;br&gt;done=1, no overrun" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s3"><mxGeometry x="20" y="42" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="k2" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;0x76 / 0x73&lt;/b&gt;&lt;/font&gt;&lt;br&gt;camera PID / VER read&lt;br&gt;over SCCB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s3"><mxGeometry x="330" y="42" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="k3" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;13.6 → 4.5 MHz&lt;/b&gt;&lt;/font&gt;&lt;br&gt;PCLK edges counted by a timer:&lt;br&gt;no filter vs 25 ns filter" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FDECEC;strokeColor=#EBA3A3;fontColor=#1B1F24;" vertex="1" parent="s3"><mxGeometry x="20" y="152" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="k4" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;≈13 s&lt;/b&gt;&lt;/font&gt;&lt;br&gt;per frame at 115200 baud&lt;br&gt;(153,600 × 10 bits)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s3"><mxGeometry x="330" y="152" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="s4" value="4 · Debug log: 12 problems, in the order they were found" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;align=left;spacingLeft=12;fillColor=#F7F8FA;strokeColor=#D5DAE1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="1320" height="360" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;1 · Board template defaults&lt;/b&gt;&lt;br&gt;CubeMX had enabled USB, Ethernet and MCO2 → disabled" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="20" y="42" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;2 · MCO2 vs DCMI_D3&lt;/b&gt;&lt;br&gt;PC9 is both MCO2 and the only reachable D3 → XCLK moved to MCO1 (PA8)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="236" y="42" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;3 · SCCB NACK&lt;/b&gt;&lt;br&gt;XCLK and PCLK wires swapped, camera had no clock → ID reads 0x76 / 0x73" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="452" y="42" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;4 · No frames (words=0)&lt;/b&gt;&lt;br&gt;Edge-count probe: VSYNC not reaching PB7 → wire re-seated" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="668" y="42" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;5 · Leftover code&lt;/b&gt;&lt;br&gt;Old capture code still ran; code outside USER CODE markers → main.c cleaned" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="884" y="42" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;6 · Bytes repeated ~4×&lt;/b&gt;&lt;br&gt;Blamed the camera scaler. Scaler off, same symptom → theory rejected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#F2F4F7;strokeColor=#B8C0CC;dashed=1;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="1100" y="42" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;7 · D3 on the wrong pin&lt;/b&gt;&lt;br&gt;.ioc had silently put DCMI_D3 on PE1 (LED); found in hal_msp.c → PC9" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="20" y="178" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;8 · Real cause of the 4×&lt;/b&gt;&lt;br&gt;Spikes on PCLK: 13.6 vs 4.5 MHz edge count → 70 Ω series resistor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#FDECEC;strokeColor=#EBA3A3;strokeWidth=2;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="236" y="178" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;9 · Wrong colours&lt;/b&gt;&lt;br&gt;DCMI byte select starts on even byte + gamma, AE, AWB, colour matrix" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="452" y="178" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;10 · DMA and errors&lt;/b&gt;&lt;br&gt;DMA priority very high; error code reset before each capture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="668" y="178" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;11 · Frames cut short&lt;/b&gt;&lt;br&gt;Copied table set DBLV (0x6B) = 0x4A: ×4 PLL on → removed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="884" y="178" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;12 · 639 bytes per line&lt;/b&gt;&lt;br&gt;Stripes and slant → viewer decodes line by line (workaround)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="1100" y="178" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="leg" value="&lt;b&gt;Colour = kind of problem:&lt;/b&gt;  &lt;font color=&quot;#5B7FD6&quot;&gt;■&lt;/font&gt; CubeMX / pin config   &lt;font color=&quot;#E08A4F&quot;&gt;■&lt;/font&gt; wiring   &lt;font color=&quot;#D46A6A&quot;&gt;■&lt;/font&gt; signal integrity   &lt;font color=&quot;#8E72D9&quot;&gt;■&lt;/font&gt; camera registers   &lt;font color=&quot;#4FA86A&quot;&gt;■&lt;/font&gt; firmware / viewer   &lt;font color=&quot;#9AA3B0&quot;&gt;■&lt;/font&gt; wrong hypothesis (dashed)" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="s4"><mxGeometry x="20" y="312" width="1280" height="34" as="geometry"/></mxCell>
<mxCell id="s5" value="5 · How the 4× repeated bytes were solved" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;align=left;spacingLeft=12;fillColor=#F7F8FA;strokeColor=#D5DAE1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1320" height="170" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;Symptom&lt;/b&gt;&lt;br&gt;every byte captured about 4 times" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;" vertex="1" parent="s5"><mxGeometry x="20" y="50" width="224" height="100" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Wrong guess&lt;/b&gt;&lt;br&gt;camera scaler → turned it off, no change, so rejected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F2F4F7;strokeColor=#B8C0CC;dashed=1;fontColor=#1B1F24;" vertex="1" parent="s5"><mxGeometry x="284" y="50" width="224" height="100" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;Measure&lt;/b&gt;&lt;br&gt;timer on PA6 counts PCLK: 13.6 MHz unfiltered, 4.5 MHz with 25 ns filter" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="s5"><mxGeometry x="548" y="50" width="224" height="100" as="geometry"/></mxCell>
<mxCell id="r4" value="&lt;b&gt;Root cause&lt;/b&gt;&lt;br&gt;ringing + XCLK crosstalk on 15–20 cm jumpers; DCMI has no input filter" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FDECEC;strokeColor=#EBA3A3;fontColor=#1B1F24;" vertex="1" parent="s5"><mxGeometry x="812" y="50" width="224" height="100" as="geometry"/></mxCell>
<mxCell id="r5" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;70 Ω series resistor at the camera's PCLK pin (source termination)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#E7F6EC;strokeColor=#8BCB9F;strokeWidth=2;fontColor=#1B1F24;" vertex="1" parent="s5"><mxGeometry x="1076" y="50" width="224" height="100" as="geometry"/></mxCell>
<mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;" edge="1" parent="s5" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;" edge="1" parent="s5" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;" edge="1" parent="s5" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=2;" edge="1" parent="s5" source="r4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s6" value="6 · Lessons" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;align=left;spacingLeft=12;fillColor=#F7F8FA;strokeColor=#D5DAE1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="1265" width="640" height="165" as="geometry"/></mxCell>
<mxCell id="les" value="1. Measure instead of guessing.&lt;br&gt;2. Check the code CubeMX generated, not just the settings clicked.&lt;br&gt;3. Report numbers, not &quot;yes&quot;.&lt;br&gt;4. Change one variable at a time; see if the symptom follows it.&lt;br&gt;5. Check copied register tables for clock and timing registers." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1B1F24;spacing=6;" vertex="1" parent="s6"><mxGeometry x="20" y="42" width="600" height="115" as="geometry"/></mxCell>
<mxCell id="s7" value="7 · Open points and next steps" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;align=left;spacingLeft=12;fillColor=#F7F8FA;strokeColor=#D5DAE1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="720" y="1265" width="640" height="165" as="geometry"/></mxCell>
<mxCell id="opn" value="• Line length still varies now and then: HREF / VSYNC margin?&lt;br&gt;• A reserved tuning register may shift horizontal timing.&lt;br&gt;• 2 Mbaud UART (divides exactly from 40 MHz): ST-LINK side untested.&lt;br&gt;• Next board: STM32F446, then F401 / F411." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1B1F24;spacing=6;" vertex="1" parent="s7"><mxGeometry x="20" y="42" width="600" height="115" as="geometry"/></mxCell>
